# Copy to .env and fill in real values. Never commit .env.
# Every variable here is read through backend/config.py (pydantic-settings).

# --- Secrets ---------------------------------------------------------------
# Required: everything that reads config also reads the store.
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
# Optional here, checked at the point of use. Gold-set drafting and the
# groundedness judge need GROQ_API_KEY; pushing the reranker needs HF_TOKEN.
# Anything that needs one fails immediately, naming the variable.
GROQ_API_KEY=gsk_replace_me
HF_TOKEN=hf_replace_me

# --- Models ----------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_BASE=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TUNED=talalmohsin-98/plumbline-reranker-v1
# The groundedness judge.
GROQ_MODEL=llama-3.1-8b-instant
# Gold-set drafting: a harder, multi-constraint task than judging.
GOLDSET_MODEL=openai/gpt-oss-120b

# Query-side instruction for bge-*-en-v1.5. Not yet wired into retrieval.
BGE_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# --- Retrieval parameters --------------------------------------------------
RRF_K=60
RERANK_DEPTH=20
RETRIEVE_DEPTH=50

# --- Chunking --------------------------------------------------------------
# 512 is the max sequence length of bge-small; longer chunks are truncated at
# embed time. Overlap keeps a straddling sentence intact in one of the two.
CHUNK_SIZE=512
CHUNK_OVERLAP=64
