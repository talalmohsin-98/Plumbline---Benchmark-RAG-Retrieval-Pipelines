# Copy to .env and fill in real values. Never commit .env.
# Every variable here is read through backend/config.py (pydantic-settings).

# --- Secrets (no defaults in code) -----------------------------------------
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
GROQ_API_KEY=gsk_replace_me
HF_TOKEN=hf_replace_me

# --- Models ----------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_BASE=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TUNED=talalmohsin-98/plumbline-reranker-v1

# --- Retrieval parameters --------------------------------------------------
RRF_K=60
RERANK_DEPTH=20
RETRIEVE_DEPTH=50

# --- Chunking --------------------------------------------------------------
# 512 is the max sequence length of bge-small; longer chunks are truncated at
# embed time. Overlap keeps a straddling sentence intact in one of the two.
CHUNK_SIZE=512
CHUNK_OVERLAP=64
