# The demo corpus is rebuilt by scripts/fetch_corpus.py, not committed.
# MANIFEST.json is the pin that makes that rebuild reproducible, so it is the
# one file here that must be tracked.
data/demo_corpus/**
!data/demo_corpus/MANIFEST.json
!data/demo_corpus/.gitkeep

