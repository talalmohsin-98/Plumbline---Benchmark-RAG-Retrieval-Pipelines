# Working notes and prompt-comparison scratch, kept local.
/fresh_sample.json
/v1_v2.json
/v2_v3.json

# Regenerated by `python -m backend.goldset.multilabel`; the adjudicated
# survivors live in data/multilabel.json, which is tracked.
data/multilabel_candidates.jsonl
data/multilabel_review.jsonl

# Audit queues are outputs, rebuilt by `backend.goldset.audit --queue-only`.
# data/audit_decisions.jsonl is the durable record of what was decided.
data/audit_queue*.jsonl
data/audit_controls.json
data/audit_control_pool.txt

# Scratch output from ad-hoc diagnostic scripts. The reproducible versions
# live in data/ and are written by a committed module.
scratch_*.json
